{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(.venv/bin/python rio1/helpers/*)",
      "Bash(.venv/bin/python vendor/video-use/helpers/*)",
      "Bash(.venv/bin/python .claude/skills/tutorial-edit/scripts/*)",
      "Bash(python3 .claude/skills/studio/scripts/studio.py *)",
      "Bash(ffprobe *)",
      "Bash(mkdir -p *)",
      "Bash(ls *)",
      "Bash(jq *)",
      "Edit(runs/**)",
      "Agent(edl-editor)",
      "Agent(edit-verifier)",
      "Agent(blur-judge)",
      "Skill(tutorial-edit)",
      "Skill(tutorial-edit-2)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(*.env*)",
      "Bash(*../*)",
      "Bash(*://*)",
      "Bash(jq *-R*)",
      "Bash(jq *--raw-input*)",
      "Bash(jq *--rawfile*)",
      "Bash(jq *--slurpfile*)",
      "Bash(ffmpeg *)",
      "Bash(rm *)",
      "Bash(brew *)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
